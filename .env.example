# Por defecto se conecta al proyecto público definido en src/config/supabase.js.
VITE_DATA_MODE=supabase
# Opcionales: permiten conectar otro proyecto sin cambiar el código.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos que usan la clave anon JWT anterior:
VITE_SUPABASE_ANON_KEY=
# Para una prueba aislada con datos ficticios, usar VITE_DATA_MODE=demo.
